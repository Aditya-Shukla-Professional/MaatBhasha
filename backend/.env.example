# PALASH MaatBhasha — Environment Variables Template
# Copy this file to .env and fill in real values. DO NOT commit .env to git.

# Sarvam AI API key (get from https://sarvam.ai/)
SARVAM_API_KEY=your_sarvam_api_key_here

# Server port (default: 3001)
PORT=3001


# Comma-separated browser origins allowed to call the API directly
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
